<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Location Permissions ──────────────────────────────────── -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ── Usage Stats (requires Settings redirect) ──────────────── -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ── Calendar ──────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- ── Notification Access (Phase 2) ─────────────────────────── -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- ── Background Execution ──────────────────────────────────── -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Notifications (Android 13+) ───────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Exact Alarms (Phase 4 — required for time-based rules) ── -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- ── Network (optional — for Gemini LLM enhancement) ──────── -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PhoneWhispererApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneWhisperer">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PhoneWhisperer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── NotificationListenerService (Phase 2) ─────────────── -->
        <service
            android:name=".service.PhoneWhispererNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ── GeofenceBroadcastReceiver (Phase 2 + 4) ───────────── -->
        <receiver
            android:name=".receiver.GeofenceBroadcastReceiver"
            android:enabled="true"
            android:exported="true" />

        <!-- ── RuleExecutionReceiver (Phase 4) ───────────────────── -->
        <!--
            Catches exact alarms from TimeRuleScheduler and triggers
            ActionExecutor to enforce approved automation rules.
        -->
        <receiver
            android:name=".receiver.RuleExecutionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Boot Receiver — re-schedule WorkManager + rule alarms -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Note: RingerModeReceiver and ScreenStateReceiver are registered
            dynamically in PhoneWhispererApp.onCreate() because their intent
            filters (RINGER_MODE_CHANGED, SCREEN_ON/OFF) are implicit broadcasts
            that cannot be received via manifest on Android 8+.
        -->

        <!--
            Disable default WorkManager initialization.
            We provide a custom Configuration via PhoneWhispererApp (Configuration.Provider)
            to inject HiltWorkerFactory.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
